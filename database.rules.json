{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-zA-Z0-9-]{20,80}$/)",
        "devices": {
          "$device": {
            ".write": "auth != null && $room.matches(/^[a-zA-Z0-9-]{20,80}$/) && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['owner','name','lat','lng','accuracy','speed','updatedAt','color']) && newData.child('owner').val() === auth.uid",
            "owner": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "speed": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "heading": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isString()"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "trail": {
              "$point": {
                ".validate": "newData.hasChildren(['lat','lng','timestamp']) && $point.matches(/^([0-9]|[1-9][0-9]|[1-4][0-9][0-9])$/)",
                "lat": {
                  ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
                },
                "lng": {
                  ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
                },
                "timestamp": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
